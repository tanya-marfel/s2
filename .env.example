# Copy to .env and fill in. .env is gitignored - never commit real keys.
#   cp .env.example .env && chmod 600 .env

# Google AI Studio / Gemini
GEMINI_API_KEY=

# condense.chat proxy key (starts with ak_)
CONDENSE_API_KEY=

# Route LLM calls through the condense proxy. Set to 0 to call providers directly.
USE_CONDENSE=1

# condense forwards to this upstream. Gemini's OpenAI-compatible endpoint lets a
# single call exercise both partners. Requires the upstream-override entitlement
# on your condense account, otherwise the proxy returns 403.
CONDENSE_UPSTREAM_URL=https://generativelanguage.googleapis.com/v1beta/openai

GEMINI_MODEL=gemini-flash-latest
